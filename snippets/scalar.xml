<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="scalar"
           fetch="https://github.com/prjkt-scalar"
           revision="refs/heads/17" />

  <!-- Removed LineageOS projects -->

  <!-- Manifest -->
  <remove-project name="LineageOS/android" />

  <!-- Frameworks Base -->
  <remove-project name="LineageOS/android_frameworks_base" />

  <!-- Launcher3 -->
  <remove-project name="LineageOS/android_packages_apps_Launcher3" />

  <!-- Settings -->
  <remove-project name="LineageOS/android_packages_apps_Settings" />

  <!-- Vendor Lineage -->
  <remove-project name="LineageOS/android_vendor_lineage" />

  <!-- Scalar forks -->

  <!-- Manifest -->
  <project path="android" name="manifest" remote="scalar" />

  <!-- Frameworks Base -->
  <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="scalar" />

  <!-- Launcher3 -->
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="scalar" />

  <!-- Settings -->
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="scalar" />

  <!-- Vendor Lineage -->
  <project path="vendor/lineage" name="android_vendor_lineage" remote="scalar" />

</manifest>
